generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           Int                  @id @default(autoincrement())
  email                        String               @unique
  password                     String?
  Fname                        String
  Lname                        String
  Mname                        String?
  address                      String?
  createdAt                    DateTime             @default(now())
  createdById                  Int?
  emailConfirmationToken       String?              @unique
  emailConfirmationTokenExpiry DateTime?
  emailVerified                Boolean?             @default(false)
  googleId                     String?              @unique
  isGoogleUser                 Boolean?             @default(false)
  lastModifiedById             Int?
  phone                        String?
  photo                        String?
  resetToken                   String?              @unique
  resetTokenExpiry             DateTime?
  role                         Role                 @default(FARMER)
  status                       UserStatus           @default(INACTIVE)
  updatedAt                    DateTime             @updatedAt
  warehouseId                  Int?
  paymentDetails               Json?
  performedActions             ActivityLog[]        @relation("ActionPerformer")
  activityLogs                 ActivityLog[]        @relation("UserActivities")
  receivedInvitations          Invitation[]         @relation("InvitationReceiver")
  sentInvitations              Invitation[]         @relation("InvitationSender")
  farmerPayments               Payment[]            @relation("FarmerPayments")
  processedPayments            Payment[]            @relation("PaymentProcessor")
  products                     Products[]
  createdBy                    User?                @relation("UserCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdUsers                 User[]               @relation("UserCreator")
  lastModifiedBy               User?                @relation("UserModifier", fields: [lastModifiedById], references: [id], onDelete: Cascade)
  modifiedUsers                User[]               @relation("UserModifier")
  warehouse                    Warehouse?           @relation("WarehouseFarmers", fields: [warehouseId], references: [id], onDelete: Cascade)
  managedWarehouse             Warehouse?           @relation("WarehouseManager")
  inventoryRecords             WarehouseInventory[] @relation("InventoryRecorder")
}

model Warehouse {
  id          Int                  @id @default(autoincrement())
  name        String
  location    String
  address     String?
  capacity    Int?
  phone       String?
  email       String?
  managerId   Int                  @unique
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  invitations Invitation[]
  products    Products[]
  farmers     User[]               @relation("WarehouseFarmers")
  manager     User                 @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: Cascade)
  inventory   WarehouseInventory[]
}

model Products {
  id                 Int                  @id @default(autoincrement())
  name               String
  grade              String
  quantity           Int
  price              Float
  variety            String
  location           String
  image              String?
  createdAt          DateTime             @default(now())
  description        String?
  farmerId           Int
  updatedAt          DateTime             @updatedAt
  warehouseId        Int
  payments           Payment[]
  farmer             User                 @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  warehouse          Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  inventoryMovements WarehouseInventory[]
}

model WarehouseInventory {
  id           Int          @id @default(autoincrement())
  productId    Int
  warehouseId  Int
  quantityIn   Int?
  quantityOut  Int?
  currentStock Int
  movementType MovementType
  reason       String?
  recordedById Int?
  createdAt    DateTime     @default(now())
  product      Products     @relation(fields: [productId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("InventoryRecorder", fields: [recordedById], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
}

model Payment {
  id              Int            @id @default(autoincrement())
  farmerId        Int
  productId       Int
  amount          Float
  quantity        Int
  pricePerUnit    Float
  status          PaymentStatus  @default(PENDING)
  paymentMethod   PaymentMethod?
  referenceNumber String?        @unique
  dueDate         DateTime?
  paidDate        DateTime?
  notes           String?
  processedById   Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  farmer          User           @relation("FarmerPayments", fields: [farmerId], references: [id], onDelete: Cascade)
  processedBy     User?          @relation("PaymentProcessor", fields: [processedById], references: [id], onDelete: Cascade)
  product         Products       @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Invitation {
  id          Int              @id @default(autoincrement())
  senderId    Int?
  receiverId  Int?
  warehouseId Int
  status      InvitationStatus @default(PENDING)
  message     String?
  sentAt      DateTime         @default(now())
  respondedAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  token       String?          @unique
  tokenUsed   Boolean          @default(false)
  receiver    User?            @relation("InvitationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender      User?            @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id            Int        @id @default(autoincrement())
  performedById Int?
  targetUserId  Int?
  action        ActionType
  entityType    EntityType
  entityId      Int?
  description   String
  metadata      Json?
  createdAt     DateTime   @default(now())
  performedBy   User?      @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Cascade)
  targetUser    User?      @relation("UserActivities", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([performedById])
  @@index([targetUserId])
  @@index([action])
  @@index([entityType])
}

enum Role {
  ADMINISTRATOR
  FARMER
  BUYER
  WAREHOUSE_GUY
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CHEQUE
  CREDIT_CARD
  DEBIT_CARD
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  DAMAGED
  EXPIRED
}

enum ActionType {
  CREATED
  UPDATED
  DELETED
  ACTIVATED
  DEACTIVATED
  SUSPENDED
  INVITED
  ACCEPTED_INVITATION
  REJECTED_INVITATION
  PAYMENT_PROCESSED
  INVENTORY_UPDATED
  PASSWORD_RESET
  LOGIN
  LOGOUT
  PAYMENT_DETAILS_UPDATED
}

enum EntityType {
  USER
  PRODUCT
  WAREHOUSE
  PAYMENT
  INVITATION
  INVENTORY
  SYSTEM
}

model TyType {
  id          Int      @id @default(autoincrement())
  entityId    Int?
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
}
